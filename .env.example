# ===========================================================================
# ELYP ATELIÊ — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA suba o ".env" pro Git (o .gitignore já está configurado pra isso).
# ===========================================================================

# --- Banco de dados (Postgres) ---------------------------------------------
# Crie um banco grátis em https://neon.tech ou https://supabase.com
# Neon/Supabase te dão essa URL pronta na hora que você cria o projeto.
DATABASE_URL="postgresql://usuario:senha@host:5432/elyp_atelie?sslmode=require"

# --- NextAuth ----------------------------------------------------------------
# Gere um valor aleatório com: openssl rand -base64 32
NEXTAUTH_SECRET="cole-aqui-uma-string-aleatoria-longa"
NEXTAUTH_URL="http://localhost:3000"   # em produção: https://seudominio.com

# --- Login com Google ---------------------------------------------------------
# 1. Vá em https://console.cloud.google.com/apis/credentials
# 2. Crie um "OAuth 2.0 Client ID" do tipo "Web application"
# 3. Em "Authorized redirect URIs" adicione:
#    http://localhost:3000/api/auth/callback/google (dev)
#    https://seudominio.com/api/auth/callback/google (produção)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Login por telefone (SMS) -------------------------------------------------
# Crie uma conta em https://www.twilio.com (tem crédito grátis pra testar)
# Sem essas chaves preenchidas, o sistema cai automaticamente em modo DEMO
# (mostra o código na tela em vez de mandar SMS de verdade).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- Pagamento (Mercado Pago) --------------------------------------------------
# 1. Crie uma conta em https://www.mercadopago.com.br/developers
# 2. Pegue o Access Token em "Suas integrações" > sua aplicação > Credenciais
MERCADOPAGO_ACCESS_TOKEN=""
# URL pública que o Mercado Pago vai chamar quando o pagamento for confirmado
# (em produção: https://seudominio.com/api/webhooks/mercadopago)
MERCADOPAGO_WEBHOOK_URL="http://localhost:3000/api/webhooks/mercadopago"

# --- E-mail transacional (confirmação de pedido) -------------------------------
# Crie uma conta grátis em https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Elyp Ateliê <pedidos@seudominio.com>"

# --- Upload de imagens dos produtos ---------------------------------------------
# No painel da Vercel: Storage > Create Database > Blob
BLOB_READ_WRITE_TOKEN=""

# --- Frete (opcional, avançado) --------------------------------------------------
# Se quiser cotação real dos Correios/transportadoras (em vez da estimativa por
# cidade/UF que já vem pronta), crie conta em https://melhorenvio.com.br e
# preencha isso. Sem isso, o sistema usa as faixas configuráveis (local/estado/
# nacional) que já estão em Configurações > Frete.
MELHOR_ENVIO_TOKEN=""

# --- PIN administrativo de emergência (fallback) ---------------------------------
# Só é usado se você quiser manter uma trava extra além do login por e-mail/Google
# nas rotas /admin. Deixe em branco para desativar.
ADMIN_FALLBACK_PIN=""
